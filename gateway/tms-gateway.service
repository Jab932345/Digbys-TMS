[Unit]
Description=Digby's TMS gateway (D1 Mini units <-> Supabase)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/tms-gateway.env
ExecStart=/usr/bin/python3 /opt/tms-gateway/tms_gateway.py
DynamicUser=yes
StateDirectory=tms-gateway
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
